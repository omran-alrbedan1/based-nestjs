# Application runtime. Copy this file to .env and replace all placeholder secrets.
NODE_ENV=development
PORT=3000

# Prisma/PostgreSQL connection used by the API. Keep the port aligned with POSTGRES_PORT below.
DATABASE_URL=postgresql://postgres:replace-with-a-development-password@localhost:5436/red_power_garage?schema=public

# Use independently generated secrets of at least 32 characters. Never reuse these examples.
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-token-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated absolute origins. Wildcards are rejected because credentials are enabled.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Exposes Swagger UI at /api/docs when true.
SWAGGER_ENABLED=true

# Development Docker PostgreSQL settings. Never reuse development credentials in production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-development-password
POSTGRES_DB=red_power_garage
POSTGRES_PORT=5436
