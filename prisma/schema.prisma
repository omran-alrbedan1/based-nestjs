generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum FuelLevel {
  EMPTY
  QUARTER
  HALF
  THREE_QUARTERS
  FULL
}

enum MaintenanceCardStatus {
  OPEN
  CLOSED
}

enum MaintenanceWorkStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  password     String
  firstName    String?  @db.VarChar(100)
  lastName     String?  @db.VarChar(100)
  role         Role
  isActive     Boolean  @default(true)
  refreshToken String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  maintenanceCardsCreated MaintenanceCard[]            @relation("MaintenanceCardsCreated")
  maintenanceCardsClosed  MaintenanceCard[]            @relation("MaintenanceCardsClosed")
  statusEventsChanged     MaintenanceCardStatusEvent[] @relation("StatusEventsChanged")
  visitReasonsCreated     VisitReason[]                @relation("VisitReasonsCreated")
  conditionOptionsCreated VehicleConditionOption[]     @relation("ConditionOptionsCreated")
  itemOptionsCreated      VehicleItemOption[]          @relation("ItemOptionsCreated")
  photosUploaded          MaintenanceCardPhoto[]       @relation("PhotosUploaded")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  phone     String   @db.VarChar(30)
  email     String?  @db.VarChar(254)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  vehicleOwnerships VehicleOwnership[]
  maintenanceCards  MaintenanceCard[]

  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([isActive])
  @@map("customers")
}

model Vehicle {
  id              String           @id @default(uuid()) @db.Uuid
  make            String           @db.VarChar(100)
  model           String           @db.VarChar(100)
  manufactureYear Int
  plateNumber     String           @db.VarChar(30)
  color           String?          @db.VarChar(50)
  vin             String?          @unique @db.VarChar(17)
  transmission    TransmissionType
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  ownerships VehicleOwnership[]

  @@index([plateNumber])
  @@index([plateNumber, isActive])
  @@index([make, model])
  @@index([isActive])
  @@map("vehicles")
}

model VehicleOwnership {
  id         String    @id @default(uuid()) @db.Uuid
  vehicleId  String    @db.Uuid
  customerId String    @db.Uuid
  startedAt  DateTime  @db.Timestamptz(3)
  endedAt    DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  maintenanceCards MaintenanceCard[]

  @@unique([id, customerId])
  @@index([vehicleId, startedAt])
  @@index([customerId, startedAt])
  @@index([vehicleId, endedAt])
  @@map("vehicle_ownerships")
}

model MaintenanceCard {
  id                   String                @id @default(uuid()) @db.Uuid
  cardNumber           String                @unique @db.VarChar(50)
  customerId           String                @db.Uuid
  vehicleOwnershipId   String                @db.Uuid
  receivedAt           DateTime              @db.Timestamptz(3)
  expectedDeliveryAt   DateTime?             @db.Timestamptz(3)
  mileage              Int
  fuelLevel            FuelLevel
  customerComplaint    String?               @db.Text
  inspectionNotes      String?               @db.Text
  status               MaintenanceCardStatus @default(OPEN)
  customerApproved     Boolean               @default(false)
  customerApprovalName String?               @db.VarChar(150)
  customerApprovedAt   DateTime?             @db.Timestamptz(3)
  signatureStorageKey  String?               @db.VarChar(500)
  createdByUserId      String                @db.Uuid
  closedByUserId       String?               @db.Uuid
  closedAt             DateTime?             @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)

  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleOwnership VehicleOwnership @relation(fields: [vehicleOwnershipId, customerId], references: [id, customerId], onDelete: Restrict)
  createdBy        User             @relation("MaintenanceCardsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  closedBy         User?            @relation("MaintenanceCardsClosed", fields: [closedByUserId], references: [id], onDelete: Restrict)

  statusEvents     MaintenanceCardStatusEvent[]
  visitReasons     MaintenanceCardVisitReason[]
  conditionOptions MaintenanceCardConditionOption[]
  itemOptions      MaintenanceCardItemOption[]
  requiredWorks    MaintenanceCardRequiredWork[]
  photos           MaintenanceCardPhoto[]

  @@index([customerId])
  @@index([vehicleOwnershipId])
  @@index([status])
  @@index([receivedAt])
  @@index([expectedDeliveryAt])
  @@index([createdByUserId])
  @@index([closedByUserId])
  @@map("maintenance_cards")
}

model MaintenanceCardStatusEvent {
  id                String                 @id @default(uuid()) @db.Uuid
  maintenanceCardId String                 @db.Uuid
  fromStatus        MaintenanceCardStatus?
  toStatus          MaintenanceCardStatus
  changedByUserId   String                 @db.Uuid
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)

  maintenanceCard MaintenanceCard @relation(fields: [maintenanceCardId], references: [id], onDelete: Cascade)
  changedBy       User            @relation("StatusEventsChanged", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([maintenanceCardId, createdAt])
  @@index([changedByUserId])
  @@map("maintenance_card_status_events")
}

model VisitReason {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(100)
  label           String   @db.VarChar(150)
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  createdBy  User                         @relation("VisitReasonsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cardUsages MaintenanceCardVisitReason[]

  @@index([isActive, displayOrder])
  @@index([createdByUserId])
  @@map("visit_reasons")
}

model VehicleConditionOption {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(100)
  label           String   @db.VarChar(150)
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  createdBy  User                             @relation("ConditionOptionsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cardUsages MaintenanceCardConditionOption[]

  @@index([isActive, displayOrder])
  @@index([createdByUserId])
  @@map("vehicle_condition_options")
}

model VehicleItemOption {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(100)
  label           String   @db.VarChar(150)
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  createdBy  User                        @relation("ItemOptionsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cardUsages MaintenanceCardItemOption[]

  @@index([isActive, displayOrder])
  @@index([createdByUserId])
  @@map("vehicle_item_options")
}

model MaintenanceCardVisitReason {
  maintenanceCardId String   @db.Uuid
  visitReasonId     String   @db.Uuid
  selectedAt        DateTime @default(now()) @db.Timestamptz(3)

  maintenanceCard MaintenanceCard @relation(fields: [maintenanceCardId], references: [id], onDelete: Cascade)
  visitReason     VisitReason     @relation(fields: [visitReasonId], references: [id], onDelete: Restrict)

  @@id([maintenanceCardId, visitReasonId])
  @@index([visitReasonId])
  @@map("maintenance_card_visit_reasons")
}

model MaintenanceCardConditionOption {
  maintenanceCardId String   @db.Uuid
  conditionOptionId String   @db.Uuid
  selectedAt        DateTime @default(now()) @db.Timestamptz(3)

  maintenanceCard MaintenanceCard        @relation(fields: [maintenanceCardId], references: [id], onDelete: Cascade)
  conditionOption VehicleConditionOption @relation(fields: [conditionOptionId], references: [id], onDelete: Restrict)

  @@id([maintenanceCardId, conditionOptionId])
  @@index([conditionOptionId])
  @@map("maintenance_card_condition_options")
}

model MaintenanceCardItemOption {
  maintenanceCardId String   @db.Uuid
  itemOptionId      String   @db.Uuid
  selectedAt        DateTime @default(now()) @db.Timestamptz(3)

  maintenanceCard MaintenanceCard   @relation(fields: [maintenanceCardId], references: [id], onDelete: Cascade)
  itemOption      VehicleItemOption @relation(fields: [itemOptionId], references: [id], onDelete: Restrict)

  @@id([maintenanceCardId, itemOptionId])
  @@index([itemOptionId])
  @@map("maintenance_card_item_options")
}

model MaintenanceCardRequiredWork {
  id                String                @id @default(uuid()) @db.Uuid
  maintenanceCardId String                @db.Uuid
  description       String                @db.Text
  displayOrder      Int                   @default(0)
  isRequired        Boolean               @default(true)
  status            MaintenanceWorkStatus @default(PENDING)
  estimatedCost     Decimal?              @db.Decimal(12, 2)
  completedAt       DateTime?             @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)

  maintenanceCard MaintenanceCard @relation(fields: [maintenanceCardId], references: [id], onDelete: Cascade)

  @@unique([maintenanceCardId, displayOrder])
  @@index([maintenanceCardId])
  @@index([maintenanceCardId, status])
  @@map("maintenance_card_required_works")
}

model MaintenanceCardPhoto {
  id                String   @id @default(uuid()) @db.Uuid
  maintenanceCardId String   @db.Uuid
  storageKey        String   @unique @db.VarChar(500)
  originalFileName  String?  @db.VarChar(255)
  mimeType          String?  @db.VarChar(100)
  sizeBytes         BigInt?
  displayOrder      Int      @default(0)
  uploadedByUserId  String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  maintenanceCard MaintenanceCard @relation(fields: [maintenanceCardId], references: [id], onDelete: Cascade)
  uploadedBy      User            @relation("PhotosUploaded", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([maintenanceCardId, displayOrder])
  @@index([uploadedByUserId])
  @@map("maintenance_card_photos")
}
